{
  "name": "fintrack",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "FinTrack — controle de gastos pessoais: React + Express + SQLite",
  "scripts": {
    "setup": "npm install && npm --prefix client install",
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start": "cross-env NODE_ENV=production node server/index.js",
    "importar": "node server/scripts/importar-planilha.js",
    "limpar": "node server/scripts/limpar-cartao.js",
    "reset": "node server/scripts/reset.js",
    "migrar:sqlite": "node server/scripts/migrar-do-sqlite.js",
    "banco:subir": "docker compose up -d banco",
    "docker:subir": "docker compose up -d --build",
    "docker:parar": "docker compose down",
    "docker:logs": "docker compose logs -f app"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "multer": "^2.2.0",
    "pdfjs-dist": "^6.2.108",
    "pg": "^8.13.1",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "better-sqlite3": "^12.4.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3"
  }
}
