# Copie para `.env` e ajuste o que quiser. Todos têm padrão: sem o arquivo, o
# `docker compose up` funciona do mesmo jeito.
#
#   cp .env.example .env

# --- banco ---------------------------------------------------------------
POSTGRES_USER=fintrack
POSTGRES_PASSWORD=fintrack
POSTGRES_DB=fintrack

# Porta do Postgres na sua máquina. Troque se a 5432 já estiver ocupada por
# outra instalação.
POSTGRES_PORT=5432

# --- app -----------------------------------------------------------------
APP_PORT=3333

# Usado quando o app roda FORA do compose (`npm run dev`), contra o banco do
# container. Dentro do compose, o endereço é montado pelo próprio arquivo e
# aponta para o serviço `banco`.
DATABASE_URL=postgres://fintrack:fintrack@localhost:5432/fintrack

# --- IA local (opcional) -------------------------------------------------
# O serviço `ia` do compose roda o modelo. Estes são os padrões; mexa só se
# trocar de modelo ou apontar para um Ollama que já roda em outro lugar.
IA_URL=http://ia:11434
IA_MODELO_TEXTO=qwen3:8b
IA_MODELO_VISAO=qwen3-vl:8b

# Quanto tempo o modelo fica residente na VRAM entre chamadas.
OLLAMA_KEEP_ALIVE=30m

# Pasta de modelos. Vazio = volume do Docker. Aponte para uma pasta do host se
# já tiver modelos baixados lá e quiser reaproveitá-los:
#   OLLAMA_MODELS=${USERPROFILE}/.ollama      (Windows)
#   OLLAMA_MODELS=${HOME}/.ollama             (Linux/macOS)
